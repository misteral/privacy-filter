#!/usr/bin/env python3
"""Small CLI for the MLX Privacy Filter backend."""

from __future__ import annotations

import argparse
import json
import sys

from opf_mlx import OPFMLX


def main() -> None:
    parser = argparse.ArgumentParser(description="Run OpenAI Privacy Filter with MLX")
    parser.add_argument("text", nargs="*", help="Text to redact. Reads stdin when omitted.")
    parser.add_argument("--checkpoint", "-c", help="Checkpoint directory (default: OPF_CHECKPOINT or ~/.opf/privacy_filter)")
    parser.add_argument("--context", type=int, default=4096, help="Context window length (default: 4096)")
    parser.add_argument("--moe-chunk-size", type=int, default=8, help="MoE routing chunk size; lower uses less memory")
    parser.add_argument("--decode-mode", choices=["viterbi", "argmax"], default="viterbi")
    parser.add_argument("--output-mode", choices=["typed", "redacted"], default="typed")
    parser.add_argument("--text-only", action="store_true", help="Print only redacted text")
    parser.add_argument("--json", action="store_true", help="Print structured JSON result")
    args = parser.parse_args()

    text = " ".join(args.text) if args.text else sys.stdin.read()
    if not text:
        parser.error("provide text argument(s) or stdin")

    opf = OPFMLX(
        model=args.checkpoint,
        context_window_length=args.context,
        moe_chunk_size=args.moe_chunk_size,
        decode_mode=args.decode_mode,
        output_mode=args.output_mode,
        output_text_only=args.text_only,
    )
    result = opf.redact(text)
    if isinstance(result, str):
        print(result)
    elif args.json:
        print(result.to_json())
    else:
        print(result.redacted_text)
        if result.detected_spans:
            print(json.dumps(result.to_dict()["detected_spans"], ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
